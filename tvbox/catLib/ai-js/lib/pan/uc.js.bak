/**
 * UC网盘处理工具
 * 
 * 提供UC网盘分享链接解析、文件下载等功能。
 * 
 * @module UCPanHandler
 * @author 优雅
 * @since 1.0.0
 */

import { Crypto as CryptoJS } from 'assets://js/lib/cat.js';

// 全局调试开关
let DEBUG = globalThis.uc_debug || 0;
// 站点名称
let siteName = '优汐';

// ==================== 日志函数 ====================

/**
 * 日志输出
 * @param {number} level - 日志级别 (0=调试, 1=成功, 2=警告, 3=错误, 4=信息)
 * @param {string} tag - 日志标签
 * @param {string} msg - 日志消息
 * @param {number} duration - 耗时(毫秒)
 */
function log(level, tag, msg, startTime) {
    if (DEBUG == 0) return;
    if (DEBUG == 1 && level !== 4) return;
    let prefix = ['🔍', '✅', '⚠️', '❌', '⚙️'][level] || '📝';
    let timeStr = startTime !== undefined ? ` 耗时⏱️${Date.now() - startTime}ms` : '';
    console.log(`${prefix}【${siteName}-${tag}】 ${msg}${timeStr}`);
}

// ==================== 错误码定义 ====================
const ERROR_CODES = {
    31001: "Token或Cookie无效，请重新获取",
    31003: "签名验证失败",
    32001: "请求过于频繁，请稍后再试",
    32003: "网盘空间不足，请清理空间或开通会员",
    32004: "Cookie已失效，请重新获取",
    32005: "文件不存在",
    32006: "文件已被删除",
    32009: "分享链接已失效",
    32010: "提取码错误",
    33001: "参数错误",
    34001: "系统繁忙，请稍后重试",
    36001: "转存失败，文件可能已被删除",
    37001: "获取播放地址失败",
};

// 空间不足错误码列表
const SPACE_ERROR_CODES = [32003, 32008];

// Cookie失效错误码列表
const COOKIE_EXPIRED_CODES = [31001, 31002, 32004, 32011];

// ==================== 辅助函数 ====================

function getErrorMessage(code) {
    let numCode;
    if (typeof code === 'string') {
        const match = code.match(/\d+/);
        numCode = match ? parseInt(match[0], 10) : parseInt(code, 10);
    } else {
        numCode = code;
    }
    
    if (ERROR_CODES[numCode]) {
        return ERROR_CODES[numCode];
    }
    
    if (numCode >= 50000 && numCode <= 59999) {
        return '服务内部错误 (' + numCode + ')，请稍后重试';
    }
    
    return '请求失败 (code: ' + code + ')';
}

function parseJwtToken(token) {
    if (!token) return null;
    try {
        const parts = token.split('.');
        if (parts.length < 2) return null;
        const payload = JSON.parse(CryptoJS.enc.Base64.parse(parts[1]).toString(CryptoJS.enc.Utf8));
        const exp = payload.exp * 1000;
        const remainingMs = exp - Date.now();
        const remainingDays = Math.floor(remainingMs / (1000 * 60 * 60 * 24));
        const remainingHours = Math.floor((remainingMs % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        
        return {
            exp: exp,
            remainingMs: remainingMs,
            remainingDays: remainingDays,
            remainingHours: remainingHours,
            isValid: remainingMs > 0
        };
    } catch (e) {
        return null;
    }
}

function isValidJwtToken(token) {
    if (!token || typeof token !== 'string') return false;
    return token.startsWith('eyJ');
}

// ==================== 批量并发请求工具 ====================

async function batchFetch2(requests, timeout = 8000) {
    if (!requests || requests.length === 0) return [];
    let t1 = Date.now();
    
    const promises = requests.map(async (item) => {
        try {
            const url = typeof item === 'string' ? item : item.url;
            const options = typeof item === 'string' 
                ? { timeout: timeout }
                : (item.options || { timeout: timeout });
            const result = await req(url, options);
            return result.content || result;
        } catch (error) {
            log(3, '批量请求', url + ': ' + error);
            return null;
        }
    });
    
    const results = await Promise.all(promises);
    log(0, '批量请求', requests.length + '个请求全部并发', Date.now() - t1);
    return results;
}

function getBatchFn(requests) {
    if (typeof batchFetch === 'function') {
        return batchFetch(requests);
    }
    return batchFetch2(requests);
}

function delay(ms) {
    return new Promise((resolve) => setTimeout(resolve, ms));
}

// ==================== UC网盘处理类 ====================

class UCHandler {
    constructor() {
        this.regex = /https:\/\/drive\.uc\.cn\/s\/([^?&#]+)(?:\?.*?pwd=([^&]+))?/;
        this.pr = 'pr=UCBrowser&fr=pc';
        this.baseHeader = {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) uc-cloud-drive/1.8.5 Chrome/100.0.4896.160 Electron/18.3.5.16-b62cf9c50d Safari/537.36 Channel/ucpan_other_ch',
            'Referer': 'https://drive.uc.cn/',
            'Origin': 'https://drive.uc.cn',
            'Content-Type': 'application/json'
        };
        this.apiUrl = 'https://pc-api.uc.cn/1/clouddrive';
        this.shareTokenCache = {};
        this.saveFileIdCaches = {};
        this.urlCache = {};
        this.cacheTTL = 20 * 60 * 1000;
        this.saveDirName = 'drpy';
        this.saveDirId = null;
        this.subtitleExts = ['.srt', '.ass', '.scc', '.stl', '.ttml'];
        this.videoExts = ['.mp4', '.mkv', '.avi', '.mov', '.wmv', '.flv', '.webm', '.m4v', '.mpg', '.mpeg', '.ts', '.m3u8', '.rm', '.rmvb', '.3gp', '.m2ts', '.vob'];
        this.videoExtRegex = /\.(mp4|mkv|avi|mov|wmv|flv|webm|m4v|mpg|mpeg|rm|rmvb|3gp|ts|m2ts|vob)$/i;
        this.videoExtsEnabled = 0;
        this._cookie = "";
        this._token = "";
        this._refreshToken = null;
        this.tokenExpireTime = 0;
        this.cookieExpireTime = 0;
        this.lastRefreshTime = 0;
        this.refreshInterval = 4 * 24 * 60 * 60 * 1000;
        this.ucConfig = {
            api: "https://open-api-drive.uc.cn",
            clientID: "5acf882d27b74502b7040b0c65519aa7",
            signKey: "l3srvtd7p42l0d0x1u8d7yc8ye9kki4d",
            appVer: "1.6.8",
            channel: "UCTVOFFICIALWEB",
            deviceID: "07b48aaba8a739356ab8107b5e230ad4"
        };
        this.allowedCookieFields = ['__pus', '__puus'];
        this.autoClean = true;
        this._isRefreshing = false;
        this._refreshPromise = null;
    }

    filterCookie(cookie) {
        if (!cookie || typeof cookie !== 'string') return '';
        
        const pairs = cookie.split(';').map(p => p.trim()).filter(p => p);
        const filtered = [];
        
        for (const pair of pairs) {
            const eqIndex = pair.indexOf('=');
            if (eqIndex === -1) continue;
            const key = pair.substring(0, eqIndex).trim();
            const value = pair.substring(eqIndex + 1).trim();
            if (this.allowedCookieFields.includes(key) && value) {
                filtered.push(key + '=' + value);
            }
        }
        
        return filtered.join('; ');
    }

    isValidToken(token) {
        return isValidJwtToken(token);
    }

    get cookie() {
        if (this._cookie && this.cookieExpireTime > Date.now()) {
            return this._cookie;
        }
        if (globalThis.uc_cookie) {
            const filtered = this.filterCookie(globalThis.uc_cookie);
            if (filtered) {
                this._cookie = filtered;
                this.cookieExpireTime = Date.now() + 7 * 24 * 60 * 60 * 1000;
                return filtered;
            }
        }
        return '';
    }

    set cookie(value) {
        if (value && typeof value === 'string') {
            const filtered = this.filterCookie(value);
            if (filtered) {
                this._cookie = filtered;
                this.cookieExpireTime = Date.now() + 7 * 24 * 60 * 60 * 1000;
                globalThis.uc_cookie = filtered;
            } else {
                log(2, 'Cookie', '过滤后 Cookie 为空，需要: __pus, __puus');
                this._cookie = '';
                globalThis.uc_cookie = '';
            }
        } else {
            this._cookie = '';
            globalThis.uc_cookie = '';
        }
    }

    get token() {
        if (this._token && this.tokenExpireTime > Date.now()) {
            if (this.isValidToken(this._token)) {
                return this._token;
            } else {
                log(2, 'Token', '内存中的Token不是有效的JWT格式（应以eyJ开头），已忽略');
                this._token = null;
            }
        }
        if (globalThis.uc_token) {
            if (this.isValidToken(globalThis.uc_token)) {
                this.token = globalThis.uc_token;
                return this._token;
            } else {
                log(2, 'Token', '全局Token不是有效的JWT格式（应以eyJ开头），已忽略');
                globalThis.uc_token = '';
            }
        }
        return this._token;
    }

    set token(value) {
        if (value && typeof value === 'string') {
            if (!this.isValidToken(value)) {
                log(2, 'Token', 'Token不是有效的JWT格式（应以eyJ开头），已忽略');
                this._token = null;
                globalThis.uc_token = '';
                return;
            }
            
            this._token = value;
            globalThis.uc_token = value;
            
            const tokenInfo = parseJwtToken(value);
            if (tokenInfo) {
                this.tokenExpireTime = tokenInfo.exp;
                log(0, 'Token', '设置成功，剩余有效期: ' + tokenInfo.remainingDays + '天 ' + tokenInfo.remainingHours + '小时');
            }
        } else {
            this._token = null;
            globalThis.uc_token = '';
        }
    }

    getHeaders() {
        const cookie = this.cookie;
        const headers = { ...this.baseHeader };
        if (cookie) {
            headers.Cookie = cookie;
        }
        return headers;
    }

    async initUC() {
        if (globalThis.uc_token) {
            if (this.isValidToken(globalThis.uc_token)) {
                this.token = globalThis.uc_token;
            } else {
                log(2, '初始化', '全局Token不是有效的JWT格式（应以eyJ开头），已忽略');
                globalThis.uc_token = '';
            }
        }
        if (globalThis.uc_cookie) {
            const filtered = this.filterCookie(globalThis.uc_cookie);
            if (filtered) {
                this.cookie = filtered;
            } else {
                log(2, '初始化', '过滤后 Cookie 为空，需要: __pus, __puus');
                globalThis.uc_cookie = '';
            }
        }
        if (globalThis.uc_refresh_token) {
            if (this.isValidToken(globalThis.uc_refresh_token)) {
                this.refreshToken = globalThis.uc_refresh_token;
            } else {
                log(2, '初始化', '全局刷新Token不是有效的JWT格式（应以eyJ开头），已忽略');
                globalThis.uc_refresh_token = '';
            }
        }
        
        if (globalThis.uc_videoExtsEnabled !== undefined) this.videoExtsEnabled = globalThis.uc_videoExtsEnabled;
        if (globalThis.uc_autoClean !== undefined) this.autoClean = globalThis.uc_autoClean;
        
        log(4, '初始化', 'Token: ' + (this.token ? '有效(JWT格式)' : '无或无效'));
        log(4, '初始化', 'Cookie: ' + (this.cookie ? '有' : '无'));
        
        if (this.token) {
            const tokenRemaining = this.getTokenRemainingTime();
            if (tokenRemaining && tokenRemaining.isValid) {
                log(4, 'Token状态', '有效，剩余 ' + tokenRemaining.message);
            } else if (tokenRemaining && !tokenRemaining.isValid) {
                log(2, 'Token状态', '已过期，请重新获取');
            }
        }
        
        log(4, '初始化', '完成, 视频扩展名判断=' + (this.videoExtsEnabled === 1 ? '启用' : '禁用') + ', 自动清理=' + (this.autoClean ? '启用' : '禁用'));
        
        return { success: true };
    }

    getTokenRemainingTime() {
        if (!this.tokenExpireTime) return null;
        const remainingMs = this.tokenExpireTime - Date.now();
        if (remainingMs <= 0) return { isValid: false, remainingDays: 0, remainingHours: 0 };
        const remainingDays = Math.floor(remainingMs / (1000 * 60 * 60 * 24));
        const remainingHours = Math.floor((remainingMs % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        return {
            isValid: true,
            remainingMs: remainingMs,
            remainingDays: remainingDays,
            remainingHours: remainingHours,
            message: remainingDays + '天 ' + remainingHours + '小时'
        };
    }

    async request(url, options, retries = 2, requestType = '未知') {
        const startTime = Date.now();
        
        log(0, '请求', '【' + requestType + '】→ ' + url);
        
        const method = options.method || 'GET';
        log(0, '请求', '【' + requestType + '】方法: ' + method);
        
        if (options.headers) {
            const safeHeaders = { ...options.headers };
            if (safeHeaders.Cookie) {
                const cookiePreview = safeHeaders.Cookie.substring(0, 50) + (safeHeaders.Cookie.length > 50 ? '...' : '');
                safeHeaders.Cookie = cookiePreview;
            }
            log(0, '请求', '【' + requestType + '】请求头: ' + JSON.stringify(safeHeaders, null, 2));
        }
        
        if (options.data) {
            const dataStr = JSON.stringify(options.data, null, 2);
            if (dataStr.length > 500) {
                log(0, '请求', '【' + requestType + '】请求体(预览): ' + dataStr.substring(0, 500) + '... (总长度: ' + dataStr.length + ')');
            } else {
                log(0, '请求', '【' + requestType + '】请求体: ' + dataStr);
            }
        } else if (options.body) {
            const bodyStr = typeof options.body === 'string' ? options.body : JSON.stringify(options.body);
            if (bodyStr.length > 500) {
                log(0, '请求', '【' + requestType + '】请求体(预览): ' + bodyStr.substring(0, 500) + '... (总长度: ' + bodyStr.length + ')');
            } else {
                log(0, '请求', '【' + requestType + '】请求体: ' + bodyStr);
            }
        }
        
        let lastError = null;
        let responseTime = 0;
        
        for (let i = 0; i <= retries; i++) {
            const reqStart = Date.now();
            try {
                const response = await req(url, options);
                responseTime = Date.now() - reqStart;
                
                log(0, '响应', '【' + requestType + '】状态码: ' + (response.status || response.code || '未知'));
                log(0, '响应', '【' + requestType + '】响应耗时: ' + responseTime + 'ms');
                
                if (response.headers) {
                    const safeHeaders = { ...response.headers };
                    if (safeHeaders['set-cookie']) {
                        safeHeaders['set-cookie'] = safeHeaders['set-cookie'].substring(0, 100) + (safeHeaders['set-cookie'].length > 100 ? '...' : '');
                    }
                    log(0, '响应', '【' + requestType + '】响应头: ' + JSON.stringify(safeHeaders, null, 2));
                }
                
                const json = JSON.parse(response.content);
                
                const jsonStr = JSON.stringify(json, null, 2);
                if (jsonStr.length > 1000) {
                    log(0, '响应', '【' + requestType + '】响应体(预览): ' + jsonStr.substring(0, 1000) + '... (总长度: ' + jsonStr.length + ')');
                } else {
                    log(0, '响应', '【' + requestType + '】响应体: ' + jsonStr);
                }
                
                const code = json.code || json.status || json.errno;
                if (code && code != 200 && code != 0) {
                    const totalTime = Date.now() - startTime;
                    log(3, '请求', '【' + requestType + '】失败 (code: ' + code + ')', totalTime);
                    return {
                        error: true,
                        code: code,
                        message: getErrorMessage(code)
                    };
                }
                
                const totalTime = Date.now() - startTime;
                log(1, '请求', '【' + requestType + '】成功', totalTime);
                return json;
            } catch (error) {
                responseTime = Date.now() - reqStart;
                lastError = error;
                const retryMsg = (i + 1) + '/' + (retries + 1);
                log(3, '错误', '【' + requestType + '】失败 (' + retryMsg + '): ' + (error?.message || error) + ' 耗时' + responseTime + 'ms');
                if (i === retries) {
                    const totalTime = Date.now() - startTime;
                    log(3, '请求', '【' + requestType + '】最终失败，总耗时: ' + totalTime + 'ms', totalTime);
                    return {
                        error: true,
                        code: 31001,
                        message: lastError?.message || getErrorMessage(31001)
                    };
                }
                await delay(100);
            }
        }
        const totalTime = Date.now() - startTime;
        return {
            error: true,
            code: 31001,
            message: lastError?.message || getErrorMessage(31001)
        };
    }

    async getPages(buildRequest, size = 100) {
        const firstReq = buildRequest(1);
        const firstResult = await this.request(firstReq.url, firstReq.options, 3, '获取第一页');
        if (firstResult.error || !firstResult.data?.list) {
            return [];
        }
        
        const total = firstResult.metadata?._total || 0;
        const totalPages = Math.ceil(total / size);
        if (totalPages <= 1) {
            return firstResult.data.list;
        }
        
        const all = [...firstResult.data.list];
        const requests = [];
        for (let page = 2; page <= totalPages; page++) {
            const req = buildRequest(page);
            requests.push({ url: req.url, options: req.options });
        }
        
        const results = await getBatchFn(requests);
        for (const result of results) {
            if (result) {
                try {
                    const json = typeof result === 'string' ? JSON.parse(result) : result;
                    if (json.data?.list) {
                        all.push(...json.data.list);
                    }
                } catch (e) {}
            }
        }
        return all;
    }

    async getSharePages(shareId, folderId, stoken, size = 100) {
        const buildRequest = (page) => {
            const url = this.apiUrl + '/share/sharepage/detail?pwd_id=' + shareId + '&stoken=' + encodeURIComponent(stoken) + '&pdir_fid=' + folderId + '&force=0&_page=' + page + '&_size=' + size + '&_sort=file_type:asc,file_name:asc&' + this.pr;
            return {
                url: url,
                options: { method: 'GET', headers: this.baseHeader }
            };
        };
        return await this.getPages(buildRequest, size);
    }

    getShareData(url) {
        const matches = this.regex.exec(url);
        if (!matches || !matches[1]) return null;
        let shareId = matches[1];
        if (shareId.indexOf("?") > 0) shareId = shareId.split('?')[0];
        let passCode = matches[2] || '';
        if (url.includes('public=1')) passCode = '';
        return { shareId: shareId, folderId: '0', passCode: passCode };
    }

    async getShareToken(shareData) {
        if (!this.shareTokenCache[shareData.shareId]) {
            const url = this.apiUrl + '/share/sharepage/token?' + this.pr;
            const result = await this.request(url, {
                method: 'POST',
                data: { pwd_id: shareData.shareId, passcode: shareData.passCode || '' },
                headers: this.baseHeader
            }, 3, '获取分享令牌');
            if (result.data?.stoken) {
                this.shareTokenCache[shareData.shareId] = result.data;
            } else {
                log(3, '分享令牌', '获取失败: ' + shareData.shareId);
            }
        }
    }

    isVideoFile(item) {
        if (!item) return false;
        if (item.dir === true) return false;
        const fileName = (item.file_name || '').toLowerCase();
        if (this.videoExtsEnabled === 1) {
            return this.videoExtRegex.test(fileName) || item.obj_category === 'video';
        } else {
            return item.obj_category === 'video';
        }
    }

    formatFileSize(bytes) {
        if (!bytes || bytes == 0) return '0 B';
        const units = ['B', 'KB', 'MB', 'GB', 'TB'];
        let i = 0, size = bytes;
        while (size >= 1024 && i < units.length - 1) { size /= 1024; i++; }
        return size.toFixed(2) + ' ' + units[i];
    }

    lcs(str1, str2) {
        if (!str1 || !str2) return { length: 0, sequence: '', offset: 0 };
        let sequence = '';
        const str1Length = str1.length, str2Length = str2.length;
        const num = Array(str1Length).fill().map(() => Array(str2Length).fill(0));
        let maxlen = 0, lastSubsBegin = 0, thisSubsBegin = null;
        for (let i = 0; i < str1Length; i++) {
            for (let j = 0; j < str2Length; j++) {
                if (str1[i] === str2[j]) {
                    num[i][j] = (i === 0 || j === 0) ? 1 : 1 + num[i - 1][j - 1];
                    if (num[i][j] > maxlen) {
                        maxlen = num[i][j];
                        thisSubsBegin = i - num[i][j] + 1;
                        if (lastSubsBegin === thisSubsBegin) {
                            sequence += str1[i];
                        } else {
                            lastSubsBegin = thisSubsBegin;
                            sequence = str1.substr(lastSubsBegin, i + 1 - lastSubsBegin);
                        }
                    }
                }
            }
        }
        return { length: maxlen, sequence: sequence, offset: thisSubsBegin };
    }

    findBestLCS(mainItem, targetItems) {
        const results = [];
        let bestMatchIndex = 0;
        for (let i = 0; i < targetItems.length; i++) {
            const currentLCS = this.lcs(mainItem.name || mainItem.file_name, targetItems[i].name || targetItems[i].file_name);
            results.push({ target: targetItems[i], lcs: currentLCS });
            if (currentLCS.length > results[bestMatchIndex].lcs.length) bestMatchIndex = i;
        }
        return { allLCS: results, bestMatch: results[bestMatchIndex], bestMatchIndex: bestMatchIndex };
    }

    async getFilesByShareUrl(shareInfo, maxDepth = 2) {
        const startTime = Date.now();
        log(0, '文件列表', '开始获取 (最大深度: ' + maxDepth + ')');
        
        const shareData = typeof shareInfo === 'string' ? this.getShareData(shareInfo) : shareInfo;
        if (!shareData) {
            log(3, '文件列表', '分享链接解析失败');
            return [];
        }
        
        await this.getShareToken(shareData);
        if (!this.shareTokenCache[shareData.shareId]) {
            log(3, '文件列表', '获取分享令牌失败');
            return [];
        }
        
        const videos = [];
        const subtitles = [];
        const stoken = this.shareTokenCache[shareData.shareId].stoken;
        
        const processItems = (items) => {
            for (const item of items) {
                const fileName = item.file_name || '';
                if (item.dir === true) continue;
                if (item.file === true && item.size >= 1024 * 1024 * 5) {
                    let isVideo = false;
                    if (this.videoExtsEnabled === 1) {
                        isVideo = this.videoExts.some(ext => fileName.toLowerCase().endsWith(ext)) || item.obj_category === 'video';
                    } else {
                        isVideo = item.obj_category === 'video';
                    }
                    if (isVideo) {
                        item.stoken = stoken;
                        item.formatted_size = this.formatFileSize(item.size);
                        if (!item.share_fid_token && item.fid_token) item.share_fid_token = item.fid_token;
                        if (!item.share_fid_token) item.share_fid_token = item.fid;
                        videos.push(item);
                    }
                } else if (item.type === 'file' && this.subtitleExts.some(ext => fileName.toLowerCase().endsWith(ext))) {
                    subtitles.push(item);
                }
            }
        };
        
        const fetchLevel = async (dirs, currentDepth) => {
            if (currentDepth >= maxDepth || dirs.length === 0) return [];
            
            const requests = dirs.map(dir => {
                const url = this.apiUrl + '/share/sharepage/detail?pwd_id=' + shareData.shareId + 
                            '&stoken=' + encodeURIComponent(stoken) + '&pdir_fid=' + dir.fid + 
                            '&force=0&_page=1&_size=100&_sort=file_type:asc,file_name:asc&' + this.pr;
                return { url, options: { method: 'GET', headers: this.baseHeader } };
            });
            
            log(0, '并发获取', '第' + currentDepth + '层，' + requests.length + '个目录');
            const results = await getBatchFn(requests);
            
            const allItems = [];
            const nextLevelDirs = [];
            
            for (const result of results) {
                if (result) {
                    try {
                        const json = typeof result === 'string' ? JSON.parse(result) : result;
                        if (json.data?.list) {
                            const items = json.data.list;
                            allItems.push(...items);
                            if (currentDepth + 1 < maxDepth) {
                                for (const item of items) {
                                    if (item.dir === true) {
                                        nextLevelDirs.push({ fid: item.fid });
                                    }
                                }
                            }
                        }
                    } catch (e) {}
                }
            }
            
            processItems(allItems);
            
            if (nextLevelDirs.length > 0 && currentDepth + 1 < maxDepth) {
                await fetchLevel(nextLevelDirs, currentDepth + 1);
            }
            return allItems;
        };
        
        const rootItems = await this.getSharePages(shareData.shareId, shareData.folderId, stoken, 100);
        if (!rootItems || rootItems.length === 0) {
            log(0, '文件列表', '根目录无内容');
            return [];
        }
        
        processItems(rootItems);
        
        const rootDirs = [];
        for (const item of rootItems) {
            if (item.dir === true && maxDepth > 0) {
                rootDirs.push({ fid: item.fid });
            }
        }
        
        if (rootDirs.length > 0) {
            await fetchLevel(rootDirs, 1);
        }
        
        if (subtitles.length > 0) {
            log(0, '文件列表', '找到 ' + subtitles.length + ' 个字幕文件，开始匹配');
            for (const item of videos) {
                const matchSubtitle = this.findBestLCS(item, subtitles);
                if (matchSubtitle.bestMatch) {
                    item.subtitle = matchSubtitle.bestMatch.target;
                    log(0, '字幕匹配', item.file_name + ' -> ' + matchSubtitle.bestMatch.target.file_name);
                }
            }
        }
        
        videos.sort((a, b) => {
            const numA = parseInt((a.file_name || '').replace(/[^\d]/g, '')) || 0;
            const numB = parseInt((b.file_name || '').replace(/[^\d]/g, '')) || 0;
            return numA - numB;
        });
        
        const elapsed = Date.now() - startTime;
        log(0, '文件列表', '找到 ' + videos.length + ' 个视频 (遍历深度: ' + maxDepth + ')', elapsed);
        return videos;
    }

    async getDownload(shareId, stoken, fileId, fileToken, clean = false) {
        const cachedResult = this.getCachedUrl(shareId, fileId);
        if (cachedResult) return cachedResult;
        
        if (!this.saveFileIdCaches[fileId]) {
            const saveResult = await this.save(shareId, stoken, fileId, fileToken, clean);
            if (saveResult && saveResult.error) return saveResult;
            if (!saveResult) return { error: true, code: -1, message: '文件转存失败' };
            this.saveFileIdCaches[fileId] = saveResult;
        }
        
        let result = null;
        
        if (this.token) {
            const timestamp = Math.floor(Date.now() / 1000).toString() + '000';
            const deviceID = this.ucConfig.deviceID;
            const reqId = this.generateReqId(deviceID, timestamp);
            const x_pan_token = CryptoJS.SHA256('GET&/file&' + timestamp + '&' + this.ucConfig.signKey).toString();
            const params = {
                req_id: reqId, access_token: this.token, app_ver: this.ucConfig.appVer,
                device_id: deviceID, device_brand: 'Xiaomi', platform: 'tv',
                device_name: 'M2004J7AC', device_model: 'M2004J7AC',
                build_device: 'M2004J7AC', build_product: 'M2004J7AC',
                device_gpu: 'Adreno (TM) 550', activity_rect: '{}',
                channel: this.ucConfig.channel, method: 'streaming',
                group_by: 'source', fid: this.saveFileIdCaches[fileId],
                resolution: 'low,normal,high,super,2k,4k', support: 'dolby_vision'
            };
            const urlParams = Object.entries(params).map(([k, v]) => `${k}=${encodeURIComponent(v)}`).join('&');
            const url = `https://open-api-drive.uc.cn/file?${urlParams}`;
            
            const response = await req(url, {
                method: 'GET', headers: {
                    'User-Agent': 'Mozilla/5.0 (Linux; U; Android 9; zh-cn; RMX1931 Build/PQ3A.190605.05081124) AppleWebKit/533.1 (KHTML, like Gecko) Mobile Safari/533.1',
                    'Connection': 'Keep-Alive', 'x-pan-tm': timestamp,
                    'x-pan-token': x_pan_token, 'content-type': 'text/plain;charset=UTF-8',
                    'x-pan-client-id': this.ucConfig.clientID, 'Cookie': this.cookie
                }
            });
            
            if (response.code == 200 && response.content) {
                const jsonData = JSON.parse(response.content);
                if (jsonData.data?.video_info) {
                    result = jsonData.data.video_info.map(item => ({ name: item.resolution, url: item.url }));
                }
            }
        }
        
        if (!result) {
            const url = `${this.apiUrl}/file/download?${this.pr}`;
            const downResult = await this.request(url, {
                method: 'POST',
                data: { fids: [this.saveFileIdCaches[fileId]] },
                headers: this.getHeaders()
            }, 3, '获取下载链接');
            
            if (downResult.code && downResult.code !== 200 && downResult.code !== 0) {
                return { error: true, code: downResult.code, message: ERROR_CODES[downResult.code]?.message || '获取下载链接失败' };
            }
            
            const downloadData = downResult.data?.[0];
            if (downloadData) {
                result = [{ name: "原画", url: downloadData.download_url }];
            }
        }
        
        if (result) {
            this.setCachedUrl(shareId, fileId, result);
            return result;
        }
        
        return { error: true, code: -2, message: '获取下载链接失败，请稍后重试' };
    }

    async getUrl(params) {
        const { stoken, fidsToken = [], pwdId, fids = [], speedupSession = '' } = params;
    
        log(0, 'getUrl', '开始获取无限画质链接, fids: ' + fids.length + '个');
    
        if (!stoken) {
            log(3, 'getUrl', 'stoken不能为空');
            return { error: true, code: -1, message: 'stoken不能为空' };
        }
        if (!pwdId) {
            log(3, 'getUrl', 'pwdId不能为空');
            return { error: true, code: -1, message: 'pwdId不能为空' };
        }
        if (fids.length === 0) {
            log(3, 'getUrl', 'fids不能为空');
            return { error: true, code: -1, message: 'fids不能为空' };
        }
    
        const url = this.apiUrl + '/file/download?' + this.pr;
        const requestData = { 
            speedup_session: speedupSession || '', 
            stoken: stoken, 
            fids_token: fidsToken, 
            pwd_id: pwdId, 
            fids: fids 
        };
    
        const downResult = await this.request(url, {
            method: 'POST',
            data: requestData,
            headers: this.baseHeader
        }, 3, '获取下载链接(无限)');
    
        if (downResult.error) {
            log(3, 'getUrl', '请求失败: ' + downResult.message);
            return { error: true, code: downResult.code, message: downResult.message };
        }
    
        const downloadUrls = [];
        if (downResult.data && Array.isArray(downResult.data)) {
            for (const item of downResult.data) {
                if (item.download_url) {
                    let resolution = item.video_max_resolution || '原画';
                    let qualityName = '无限' + resolution;
                    
                    downloadUrls.push({ 
                        name: qualityName, 
                        url: item.download_url, 
                        fileId: item.fid 
                    });
                    log(0, 'getUrl', '获取到画质: ' + qualityName);
                }
            }
        }
    
        if (downloadUrls.length === 0) {
            log(3, 'getUrl', '未获取到下载链接');
            return { error: true, code: -2, message: '未获取到下载链接' };
        }
    
        const cacheKey = pwdId + '_' + fids.join('_');
        this.urlCache[cacheKey] = { urls: downloadUrls, timestamp: Date.now() };
        log(1, 'getUrl', '获取成功，共 ' + downloadUrls.length + ' 种画质');
        return downloadUrls;
    }

    async getLiveTranscoding(shareId, stoken, fileId, fileToken) {
        const cacheKey = `${shareId}_${fileId}_transcoding`;
        const cachedResult = this.urlCache[cacheKey];
        if (cachedResult && (Date.now() - cachedResult.timestamp) < this.cacheTTL) {
            return cachedResult.urls;
        }
        
        try {
            const saveFileId = await this.save(shareId, stoken, fileId, fileToken, true);
            if (!saveFileId || saveFileId.error) {
                log(3, '转码', '转存失败: ' + (saveFileId?.message || '未知错误'));
                return null;
            }
            
            const url = `${this.apiUrl}/file/v2/play?${this.pr}`;
            const result = await this.request(url, {
                method: 'POST',
                data: {
                    fid: saveFileId,
                    resolutions: 'normal,low,high,super,2k,4k',
                    supports: 'fmp4'
                },
                headers: this.getHeaders()
            }, 3, '获取转码地址');
            
            const videoList = result.data?.video_list || null;
            if (videoList && videoList.length > 0) {
                this.urlCache[cacheKey] = { urls: videoList, timestamp: Date.now() };
                log(1, '转码', '获取成功，共 ' + videoList.length + ' 种画质');
                return videoList;
            } else {
                log(2, '转码', '未获取到转码地址');
                return null;
            }
        } catch (error) {
            log(3, '转码', '异常: ' + error.message);
            return null;
        }
    }

    async deleteFile(fileId) {
        if (!fileId) return;
        const deleteUrl = `${this.apiUrl}/file/delete?${this.pr}`;
        await this.request(deleteUrl, {
            method: 'POST',
            data: { action_type: 2, filelist: [fileId], exclude_fids: [] },
            headers: this.getHeaders()
        }, 3, '删除临时文件');
    }

    async getLazyResult(downCache, mediaProxyUrl) {
        const urls = [];
        if (Array.isArray(downCache)) {
            downCache.forEach(it => {
                if (it && it.url) {
                    let url = it.url;
                    if (!url.includes('#isVideo=true')) {
                        url += "#isVideo=true##fastPlayMode##threads=10#";
                    }
                    urls.push(it.name || '未知画质', url);
                }
            });
        } else if (downCache?.download_url) {
            urls.push("原画", downCache.download_url + "#isVideo=true##fastPlayMode##threads=10#");
        } else if (downCache?.error) {
            return { parse: 0, url: [], error: downCache.message };
        }
        return { parse: 0, url: urls };
    }

    async testSupport(url, headers) {
        try {
            const resp = await req(url, {
                method: 'GET',
                headers: { ...this.baseHeader, ...headers, 'Range': 'bytes=0-0' }
            });
            
            if (resp.code === 206 || resp.code === 200) {
                const isAccept = resp.headers?.['accept-ranges'] === 'bytes';
                const contentRange = resp.headers?.['content-range'];
                const contentLength = parseInt(resp.headers?.['content-length'] || '0');
                const isSupport = isAccept || !!contentRange || contentLength === 1 || resp.status === 200;
                return [isSupport, resp.headers || {}];
            }
            return [false, null];
        } catch {
            return [false, null];
        }
    }
}

export const UC = new UCHandler();